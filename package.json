{
  "name": "improvisus-nexus",
  "version": "0.1.0",
  "description": "Improvisus Nexus desktop AI agent foundation",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run build && node scripts/smoke-desktop.mjs",
    "check": "npm run typecheck && npm test",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
