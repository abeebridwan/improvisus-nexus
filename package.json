{
  "name": "improvisus-nexus",
  "version": "0.1.0",
  "description": "Improvisus Nexus desktop AI agent foundation",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "start": "node scripts/desktop.mjs preview",
    "setup:linux": "node scripts/setup-linux-sandbox.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --test scripts/observability.test.mjs scripts/providers.test.mjs scripts/model-json.test.mjs scripts/agent-guard.test.mjs && npm run build && node scripts/smoke-desktop.mjs",
    "test:core": "npm run build && node scripts/core-ui.mjs",
    "check": "npm run typecheck && npm test",
    "browser:install": "playwright install chromium",
    "neatlogs:doctor": "neatlogs doctor --local --json",
    "neatlogs:probe": "node --env-file=.env node_modules/neatlogs/dist/cli.mjs doctor --probe --json",
    "neatlogs:verify-desktop": "npm run build && node scripts/verify-neatlogs-desktop.mjs",
    "entire:status": "entire status --detailed",
    "insta": "insta",
    "core:probe": "tsx scripts/core-probe.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "diff": "^9.0.0",
    "jsonrepair": "^3.15.0",
    "neatlogs": "^1.1.28",
    "openai": "^7.28.0",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "insta": "^0.1.23",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
