# Optional: enables desktop startup tracing. Get a real project key from neatlogs.
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com

# Hosted Agent37 agent template; no instance is created by this application.
AGENT37_API_KEY=
AGENT37_INSTANCE_URL=

# Legacy reserved model-client placeholders; Settings does not read these.
# Configure OpenAI/OpenRouter keys through Nexus OS-backed provider Settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Reserved for a future custom adapter publisher deployed on InstaCloud.
# These are application settings, not official InstaCloud API credentials.
INSTA_ADAPTER_HOST_URL=
INSTA_PUBLISH_TOKEN=

# Reserved for future discovery through Improvisus Search.
IMPROVISUS_SEARCH_URL=
